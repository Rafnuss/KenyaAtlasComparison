export/species*
data/eBird/ebd_KE_relOct-2023/ebd_KE_relOct-2023.txt

# Excel lock files
~$*

# F_analysis.m regenerates these on every run under AviList family names,
# which no longer match the 50 originally-committed filenames (retired 2019-
# checklist families) - so they'd otherwise show as new/untracked forever.
# The originals stay committed and untouched; only the newly-generated ones
# (which didn't exist before) are ignored.
export/family/*.eps
export/migrant_per_family.eps

# Derived/cached, all regenerated by the pipeline:
#   baseline maps extracted from git by Z_review.m
#   the reduced EBD table cached by C_import_ebird.m (the 864 MB source txt is
#     itself ignored above; delete this to force a re-read)
#   the review page/table written by Z_review.m
data/baseline/
data/eBird/ebd_reduced.mat
export/review/

__pycache__/

# Claude Code local session/config state, not project content
.claude/
